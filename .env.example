# ──────────────────────────────────────────────────────────────────
# LLM Bench — required / recommended
# ──────────────────────────────────────────────────────────────────

# API provider base URL (required — default: localhost)
# API_URL=http://localhost:8000/v1/chat/completions

# API key (required for most providers)
# API_KEY=sk-...

# Model name (required)
# MODEL=gpt-4o

# ──────────────────────────────────────────────────────────────────
# OpenAI-compatible providers (set API_URL only)
#   OpenAI       https://api.openai.com/v1/chat/completions
#   Anthropic    https://api.anthropic.com/v1/messages
#   Mistral      https://api.mistral.ai/v1/chat/completions
#   Groq         https://api.groq.com/openai/v1/chat/completions
#   Together     https://api.together.xyz/v1/chat/completions
#   Azure        https://<RESOURCE>.openai.azure.com/v1/chat/completions
# ──────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────
# Benchmark parameters (optional — defaults shown)
# ──────────────────────────────────────────────────────────────────

# Total benchmark duration in seconds (default: 300)
# STRESS_DURATION=300

# Warmup phase duration (default: 10)
# WARMUP_SEC=10

# Duration of each discovery plateau (default: 20)
# DISCOVERY_PLATEAU_SEC=20

# Maximum concurrency to test (default: 64)
# MAX_CONCURRENCY=64

# Request timeout in seconds (default: 180)
# REQUEST_TIMEOUT=180

# Maximum output tokens per request (default: 768)
# MAX_TOKENS=768

# Temperature (default: 0.7)
# TEMPERATURE=0.7

# Top-p (default: 0.95)
# TOP_P=0.95

# Probe interval during exploitation (default: 60)
# EXPLOIT_PROBE_INTERVAL=60

# Step size for probes (default: 2)
# STEP_SIZE=2

# Minimum success rate to accept a concurrency level (default: 0.95)
# MIN_SUCCESS_RATE=0.95

# Output files (default: stress_result.json, stress_result.csv)
# OUTPUT_JSON=stress_result.json
# OUTPUT_CSV=stress_result.csv

# Stop on total failure (default: true)
# STOP_ON_TOTAL_FAILURE=true

# Allow zero usage response (default: true)
# ALLOW_ZERO_USAGE=true

# ──────────────────────────────────────────────────────────────────
# H100 / DGX Spark — optional GPU overrides
# ──────────────────────────────────────────────────────────────────

# Set before running:
#   export CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
#   export NCCL_IB_DISABLE=0        # use InfiniBand (DGX)
#   export NCCL_SOCKET_IFNAME=eth0  # fallback to ethernet
